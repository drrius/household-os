{
  "name": "household-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "admin": "node --experimental-strip-types scripts/identity-admin.mts",
    "build": "next build --webpack",
    "check:webauthn": "node --experimental-strip-types scripts/check-webauthn-rp.mts",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run src scripts",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit && tsc --project tsconfig.domain.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:webauthn && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.16.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
