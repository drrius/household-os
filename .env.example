NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-url-safe-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-url-safe-vapid-private-key

# AI assistant (ADR 0027). Two providers; the assistant returns 503 until
# the active provider's key and TOOL_APPROVAL_SECRET are set.
# openai (default): needs OPENAI_API_KEY; HOUSEHOLD_AI_MODEL defaults to gpt-5.1.
# opencode: the OpenCode Zen gateway (OpenAI-compatible chat completions);
#   needs OPENCODE_API_KEY and an explicit HOUSEHOLD_AI_MODEL.
HOUSEHOLD_AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
HOUSEHOLD_AI_MODEL=gpt-5.1
# OPENCODE_API_KEY=replace-with-opencode-zen-api-key
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# openssl rand -base64 32 — signs in-chat approvals for financial tools.
TOOL_APPROVAL_SECRET=replace-with-32-byte-random-secret

# MCP bridge (ADR 0027). Leave unset to disable external MCP access.
# openssl rand -base64 32 — signs MCP authorization codes and grants.
MCP_GRANT_SECRET=replace-with-32-byte-random-secret
# The Supabase project's JWT signing secret (legacy HS256). Local default:
# super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Comma-separated worker origins allowed as consent redirect targets.
MCP_ALLOWED_REDIRECT_ORIGINS=http://localhost:8788
