{
  "cli": {
    "version": ">= 24.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "dsibarium@gmail.com",
        "ascAppId": "6813815649",
        "appleTeamId": "5ZKB6XKYFX"
      }
    },
    "production": {
      "ios": {
        "appleId": "dsibarium@gmail.com",
        "ascAppId": "6813815649",
        "appleTeamId": "5ZKB6XKYFX"
      }
    }
  }
}
